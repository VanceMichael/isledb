+		IdempotencyKey: "stable-key",
+		LeaseTTL:       time.Hour,
+	})
+	if err != nil {
+		t.Fatalf("first begin: %v", err)
+	}
+	firstToken, _ := first.Token()
+
+	if err := writer.Put(ctx, []byte("k"), []byte("two")); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Flush(ctx); err != nil {
+		t.Fatal(err)
+	}
+	second, err := db.BeginBackup(ctx, BackupOptions{
+		Owner:          "idem-agent",
+		IdempotencyKey: "stable-key",
